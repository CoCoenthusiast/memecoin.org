generator client {
  provider   = "prisma-client"
  output     = "../src/generated/db"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

model User {
  id        String   @id @default(cuid())
  username  String   @unique
  usernameLower String @unique
  email     String   @unique
  password  String
  role      Role     @default(USER)
  avatarUrl String?
  bannerUrl String?
  isVip     Boolean  @default(false)
  vipExpiresAt DateTime?
  isOwner   Boolean  @default(false)
  nameStyle String?
  tokenVersion Int    @default(0)
  emailVerified Boolean @default(false)
  verificationToken String? @unique
  verificationTokenExpiresAt DateTime?
  createdAt DateTime @default(now())

  posts     Post[]
  replies   Reply[]
  reactions Reaction[]
  reports   Report[]
  reportsReceived        Report[]         @relation("ReportedUser")
  writtenProfileComments ProfileComment[] @relation("ProfileCommentAuthor")
  profileComments        ProfileComment[] @relation("ProfileCommentProfileUser")
  notifications          Notification[]   @relation("NotificationRecipient")
  sentNotifications      Notification[]   @relation("NotificationActor")
  loginLogs              LoginLog[]
  bookmarks             Bookmark[]
}

model Channel {
  id        String @id @default(cuid())
  slug      String @unique
  name      String
  description String

  posts Post[]
}

model Post {
  id        String   @id @default(cuid())
  title     String
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  editedAt  DateTime?

  imageUrl        String?
  videoUrl        String?
  viewCount       Int      @default(0)
  lastActivityAt  DateTime @default(now())
  pinned          Boolean  @default(false)

  author   User    @relation(fields: [authorId], references: [id])
  authorId String

  channel   Channel @relation(fields: [channelId], references: [id])
  channelId String

  replies   Reply[]
  reactions Reaction[]
  reports   Report[]
  notifications Notification[]
  bookmarks Bookmark[]

  @@index([lastActivityAt])
  @@index([channelId, lastActivityAt])
}

model Reply {
  id        String   @id @default(cuid())
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  editedAt  DateTime?

  author   User   @relation(fields: [authorId], references: [id])
  authorId String

  post   Post   @relation(fields: [postId], references: [id])
  postId String

  parent   Reply?  @relation("ReplyToReply", fields: [parentId], references: [id])
  parentId String?
  replies  Reply[] @relation("ReplyToReply")

  reactions Reaction[]
  reports   Report[]

  @@index([postId, createdAt])
  @@index([authorId])
}

model Reaction {
  id        String   @id @default(cuid())
  type      String
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id])
  userId String

  post     Post?  @relation(fields: [postId], references: [id])
  postId   String?
  reply    Reply? @relation(fields: [replyId], references: [id])
  replyId  String?
  profileComment    ProfileComment? @relation(fields: [profileCommentId], references: [id])
  profileCommentId  String?

  @@unique([userId, postId])
  @@unique([userId, replyId])
  @@unique([userId, profileCommentId])
}

model Report {
  id        String   @id @default(cuid())
  reason    String
  status    String   @default("PENDING")
  createdAt DateTime @default(now())

  reporter   User   @relation(fields: [reporterId], references: [id])
  reporterId String

  post     Post?  @relation(fields: [postId], references: [id])
  postId   String?
  reply    Reply? @relation(fields: [replyId], references: [id])
  replyId  String?

  reportedUser   User?  @relation("ReportedUser", fields: [reportedUserId], references: [id])
  reportedUserId String?

  @@unique([reporterId, postId])
  @@unique([reporterId, replyId])
  @@unique([reporterId, reportedUserId])
  @@index([status])
}

model ProfileComment {
  id        String   @id @default(cuid())
  body      String
  createdAt DateTime @default(now())
  editedAt  DateTime?

  author   User @relation("ProfileCommentAuthor", fields: [authorId], references: [id])
  authorId String

  profileUser   User @relation("ProfileCommentProfileUser", fields: [profileUserId], references: [id])
  profileUserId String

  reactions Reaction[]
  notifications Notification[]
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  actorId   String
  postId    String?
  profileCommentId String?
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  actor User @relation("NotificationActor", fields: [actorId], references: [id], onDelete: Cascade)
  post Post? @relation(fields: [postId], references: [id], onDelete: Cascade)
  profileComment ProfileComment? @relation(fields: [profileCommentId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([read])
  @@index([userId, read])
}

model LoginLog {
  id        String   @id @default(cuid())
  ip        String
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id])
  userId String

  @@index([userId])
  @@index([createdAt])
}

model Bookmark {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId String

  @@unique([userId, postId])
  @@index([userId])
  @@index([postId])
}

model DailyRecap {
  id        String   @id @default(cuid())
  title     String
  content   String
  imageUrl  String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}
